# Safe zero-spend development defaults. Copy to .env; never commit real credentials.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://mimiz:mimiz_dev_only@localhost:5432/mimiz?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_DEMO_MODE=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
CUSTOMER_AUTH_MODE=otp
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=replace-with-a-random-secret
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
SMS_PROVIDER=console
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=
EMAIL_PROVIDER=console
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
MAPS_PROVIDER=osm
GOOGLE_MAPS_WEB_KEY=
GOOGLE_MAPS_SERVER_KEY=
NOMINATIM_USER_AGENT=MimizFoodOrdering/1.0 (contact@example.com)
NOMINATIM_CACHE_TTL_SECONDS=86400
ROUTING_ROAD_FACTOR=1.4
ROUTING_AVERAGE_SPEED_KMH=20
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
ERROR_TRACKING=log
SENTRY_DSN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
ALLOW_MOCK_IN_PRODUCTION=false
